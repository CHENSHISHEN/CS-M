{
  "name": "cs-m",
  "version": "0.5.0",
  "description": "CS-M - 开源数据建模工具",
  "scripts": {
    "test": "node tests/baseline-source.cjs && node tests/project-safety.cjs && node tests/save-state.cjs && node tests/standard-regression.cjs && node tests/workbook-branding.cjs && node tests/test-drawing-platform.cjs && node tests/test-file-guard.cjs && node tests/test-chen-core.cjs && node tests/test-chen-geometry.cjs && node tests/test-chen-persistence.cjs && node tests/test-chen-recovery.cjs && node --import ./tests/esm-loader.mjs tests/test-enterprise-modeling.mjs && node --import ./tests/esm-loader.mjs tests/test-platform-ai.mjs && node tests/test-platform-host.cjs && node tests/test-metric-platform.cjs",
    "electron": "electron ./src/main",
    "start": "node bin/start.js",
    "build": "node bin/build.js",
    "preflight": "node bin/preflight.js",
    "package-web": "node bin/build.js --web",
    "package-win": "npm run build && electron-builder --win --x64 --publish never",
    "package-mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "package-mac-arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "package-mac-x64": "npm run build && electron-builder --mac --x64 --publish never",
    "package-linux": "npm run build && electron-builder --linux --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CHENSHISHEN/CS-M.git"
  },
  "author": {
    "name": "CHENSHISHEN"
  },
  "license": "MulanPubL-2.0",
  "dependencies": {
    "@antv/hierarchy": "0.6.8",
    "@antv/x6": "1.18.3",
    "@antv/x6-react-shape": "1.3.5",
    "@electron/remote": "1.2.1",
    "crypto": "1.0.1",
    "dom-to-svg": "0.12.2",
    "dompurify": "2.5.8",
    "dot": "1.1.2",
    "electron-updater": "4.3.9",
    "html2canvas": "1.4.1",
    "jquery": "3.2.1",
    "lodash": "4.17.15",
    "marked": "2.1.3",
    "moment": "2.20.1",
    "node-sql-parser": "^5.3.13",
    "numeral": "2.0.6",
    "prop-types": "15.6.1",
    "react": "16.8.6",
    "react-ace": "9.4.1",
    "react-color": "2.18.1",
    "react-dom": "16.8.6",
    "react-redux": "7.1.0",
    "react-router-dom": "5.0.1",
    "react-virtualized-auto-sizer": "1.0.20",
    "react-vtree": "3.0.0-beta.3",
    "react-window": "1.8.9",
    "redux": "4.0.4",
    "redux-logger": "3.0.6",
    "redux-thunk": "2.3.0",
    "sortablejs": "1.7.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "xterm": "4.1.0"
  },
  "devDependencies": {
    "@babel/cli": "7.5.5",
    "@babel/core": "7.5.5",
    "@babel/plugin-proposal-class-properties": "7.5.5",
    "@babel/plugin-proposal-decorators": "7.4.4",
    "@babel/plugin-proposal-export-default-from": "7.5.2",
    "@babel/plugin-proposal-export-namespace-from": "7.5.2",
    "@babel/plugin-proposal-optional-chaining": "7.2.0",
    "@babel/polyfill": "7.4.4",
    "@babel/preset-env": "7.5.5",
    "@babel/preset-react": "7.0.0",
    "autoprefixer": "9.6.1",
    "babel-eslint": "10.0.2",
    "babel-loader": "8.0.6",
    "babel-plugin-import": "1.12.0",
    "copy-webpack-plugin": "5.0.4",
    "css-loader": "3.1.0",
    "cssnano": "4.1.10",
    "electron": "13.1.7",
    "electron-builder": "23.3.3",
    "eslint": "6.1.0",
    "eslint-config-airbnb": "17.1.1",
    "eslint-loader": "2.2.1",
    "eslint-plugin-import": "2.18.2",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react": "7.14.3",
    "file-loader": "1.1.11",
    "hoist-non-react-statics": "3.3.0",
    "html-webpack-plugin": "4.0.0-beta.8",
    "imports-loader": "0.8.0",
    "jsdom": "24.1.0",
    "less": "3.9.0",
    "less-loader": "4.1.0",
    "loader-utils": "1.2.3",
    "mini-css-extract-plugin": "0.8.0",
    "open-browser-webpack-plugin": "0.0.5",
    "optimize-css-assets-webpack-plugin": "3.2.0",
    "postcss-loader": "3.0.0",
    "resize-observer-polyfill": "1.5.1",
    "script-ext-html-webpack-plugin": "2.1.4",
    "style-loader": "0.23.1",
    "url-loader": "2.1.0",
    "webpack": "4.38.0",
    "webpack-cli": "3.3.6",
    "webpack-dev-server": "2.11.1",
    "worker-loader": "3.0.8"
  },
  "build": {
    "appId": "io.github.chenshishen.csm",
    "productName": "CS-M",
    "artifactName": "${productName}-${os}_${arch}_v${version}.${ext}",
    "electronDownload": {
      "customDir": "v13.1.7"
    },
    "directories": {
      "buildResources": "app/build",
      "output": "dist"
    },
    "files": [
      "build/"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "build/jar/",
      "build/file/",
      "build/template/"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "icon": "assets/branding/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "icon": "public/icons",
      "artifactName": "${productName}-${os}_${arch}_v${version}.${ext}",
      "target": {
        "target": "deb",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    },
    "mac": {
      "icon": "assets/branding/app.icns",
      "identity": null,
      "artifactName": "${productName}-${os}_${arch}_v${version}.${ext}",
      "target": {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    }
  }
}
